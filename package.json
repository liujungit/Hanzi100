{
  "name": "hanzi-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json *.md scripts/*.mjs",
    "sync": "npm run build && cap sync && node scripts/normalize-ios-paths.mjs",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/core": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capawesome/capacitor-file-picker": "8.1.1",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "3.6.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "4.1.12"
  }
}
